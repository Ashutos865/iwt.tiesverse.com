# Copy to .env and adjust.
PORT=5000

# Admin panel password (sent by the client as the x-admin-key header).
ADMIN_PASSWORD=iwt-admin-2026

# Secret used to HMAC-sign QR pass tokens. Change this in production —
# changing it invalidates every QR already issued.
QR_SECRET=change-me-to-a-long-random-string

# Public origin of the CLIENT app. The QR encodes <PUBLIC_BASE_URL>/verify/<token>,
# so this must be a URL a phone can open — never the API port.
PUBLIC_BASE_URL=http://localhost:5173

# ── Storage ──────────────────────────────────────────────────────────────────
# dataapi = registrations live in the TiesVerse Data API (admin.tiesverse.com)
# json    = registrations live in server/data/db.json
# Defaults to dataapi once DATA_API_ADMIN_KEY is set.
STORAGE=dataapi

# If the Data API is unreachable at boot, fall back to local JSON rather than
# refusing to start. Set false to make an unreachable API a hard failure.
STORAGE_FALLBACK=true

DATA_API_URL=https://admin.tiesverse.com
DATA_API_SLUG=iwt-summit-2026

# Server-side key: it can read AND rewrite every record in the store. Keep it
# here only — never expose it to the browser. Issue one in the admin panel at
# Data API → the store → Keys → scope "Server-side".
DATA_API_ADMIN_KEY=

# Must match one of the origins the key was issued for.
DATA_API_ORIGIN=https://iwt.tiesverse.com
